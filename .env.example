# ============================================================
# MCP Builder - Variables de Entorno
# ============================================================

# ✅ REQUERIDA: Base de datos (Neon PostgreSQL)
# Obtener en: https://console.neon.tech → Tu proyecto → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/mcp_builder?sslmode=require

# ✅ REQUERIDA: URL de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ⚙️ OPCIONAL: Entorno (development | production)
NODE_ENV=development

# ============================================================
# OPCIONALES - El sistema funciona sin estas variables
# ============================================================

# ⚡ Rate Limiting (protección contra abuso)
# Default: 100 requests por minuto si no se configura
# RATE_LIMIT_MAX=100

# 🔑 Encryption Key (solo si almacenas datos sensibles de usuarios)
# No requerida para generación de MCPs
# ENCRYPTION_KEY=your-32-char-key-here

# 🤖 OpenAI API Key (para sugerencias inteligentes con IA)
# La app funciona 100% sin ella usando búsqueda por similitud
# OPENAI_API_KEY=sk-optional
